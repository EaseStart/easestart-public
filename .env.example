# ═══════════════════════════════════════════════════════════
# EaseStart — Social Media Publisher Configuration
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# Setup Guide:
#   1. Go to https://developers.facebook.com
#   2. Select your Meta App (or create one)
#   3. Add "Facebook Login" and "Threads" products to the app
#   4. Follow instructions below for each token
#
# ═══════════════════════════════════════════════════════════

# ── Meta App ──
# Found at: App Dashboard → Settings → Basic
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# ── Facebook Page (UX Hacker) ──
# PAGE ID: Go to your page → About → Page ID (or use Graph API Explorer)
# PAGE TOKEN: Graph API Explorer → select your page → Generate Token
#   Required permissions: pages_show_list, pages_read_engagement, pages_manage_posts
#   For long-lived token: exchange short-lived token via:
#   GET /oauth/access_token?grant_type=fb_exchange_token
#     &client_id={APP_ID}&client_secret={APP_SECRET}
#     &fb_exchange_token={SHORT_LIVED_TOKEN}
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# ── Threads (via Instagram) ──
# USER ID: Your Instagram/Threads user ID (numeric)
#   Find via: GET https://graph.threads.net/v25.0/me?access_token={TOKEN}
# TOKEN: Threads API access token
#   Generate at: Meta App → Threads → Generate Token
#   Required permissions: threads_basic, threads_content_publish
#   ⚠️ threads_content_publish needs App Review approval for production!
#   In test mode, only app admins/testers can see published posts.
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here
